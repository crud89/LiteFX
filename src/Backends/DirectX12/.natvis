<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<!-- Graphics Adapter -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12GraphicsAdapter">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DirectX12GraphicsAdapter {{ Name = { impl()->m_properties.Description,sub } (Device ID = { impl()->m_properties.DeviceId }, LUID = { (uint64_t)(impl()->m_properties.AdapterLuid.HighPart &lt;&lt; 0x20) | (uint64_t)(impl()->m_properties.AdapterLuid.LowPart) }) }}</DisplayString>

		<Expand>
			<Item Name="Name">impl()->m_properties.Description,sub </Item>
			<Synthetic Name="Memory">
				<DisplayString>{ impl()->m_properties.DedicatedVideoMemory / 1048576 } Mb</DisplayString>
			</Synthetic>
			<Synthetic Name="Type">
				<DisplayString>{ ((impl()->m_properties.Flags &amp; DXGI_ADAPTER_FLAG3_SOFTWARE) ? LiteFX::Rendering::GraphicsAdapterType::CPU : LiteFX::Rendering::GraphicsAdapterType::GPU),en }</DisplayString>
			</Synthetic>
			<Synthetic Name="Luid">
				<DisplayString>{ (uint64_t)(impl()->m_properties.AdapterLuid.HighPart &lt;&lt; 0x20) | (uint64_t)(impl()->m_properties.AdapterLuid.LowPart),nvoXb }</DisplayString>
			</Synthetic>
			<Synthetic Name="Vendor ID">
				<DisplayString Condition="impl()->m_properties.VendorId == 0x1002">AMD (0x{ impl()->m_properties.VendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_properties.VendorId == 0x1010">ImgTec (0x{ impl()->m_properties.VendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_properties.VendorId == 0x10DE">NVidia (0x{ impl()->m_properties.VendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_properties.VendorId == 0x13B5">ARM (0x{ impl()->m_properties.VendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_properties.VendorId == 0x5143">Qualcom (0x{ impl()->m_properties.VendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_properties.VendorId == 0x8086">Intel (0x{ impl()->m_properties.VendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_properties.VendorId != 0x1002 &amp;&amp; impl()->m_properties.VendorId != 0x1010 &amp;&amp; impl()->m_properties.VendorId != 0x10DE &amp;&amp; impl()->m_properties.VendorId != 0x13B5 &amp;&amp; impl()->m_properties.VendorId != 0x5143 &amp;&amp; impl()->m_properties.VendorId != 0x8086">Other (0x{ impl()->m_properties.VendorId,nvoXb })</DisplayString>
			</Synthetic>
			<Item Name="Device ID">impl()->m_properties.DeviceId</Item>
			<Synthetic Name="Driver Version">
				<DisplayString>{ (impl()->m_driverVersion &amp; 0xFFFF000000000000) &gt;&gt; 0x30 }.{ (impl()->m_driverVersion &amp; 0x0000FFFF00000000) &gt;&gt; 0x20 }.{ (impl()->m_driverVersion &amp; 0x00000000FFFF0000) &gt;&gt; 0x10 }.{ (impl()->m_driverVersion &amp; 0x000000000000FFFF) &gt;&gt; 0x00 }</DisplayString>
			</Synthetic>
			<Item Name="API Version">impl()->m_apiVersion</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Surface -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12Surface">
		<DisplayString>DirectX12Surface {{ hWnd = { ((LiteFX::Resource&lt;HWND&gt;*&gt;)this)->m_handle,handle } }}</DisplayString>

		<Expand>
			<Item Name="Window">((LiteFX::Resource&lt;HWND&gt;*)this)->m_handle,handle</Item>
			<Item Name="[Resource]">(LiteFX::Resource&lt;HWND&gt;*)this</Item>
		</Expand>
	</Type>
	
	<!-- Vertex Buffer Layout -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12VertexBufferLayout">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DirectX12VertexBufferLayout {{ Binding = { impl()->m_binding }, Size = { impl()->m_vertexSize } ({ impl()->m_attributes._Mypair._Myval2._Mylast - impl()->m_attributes._Mypair._Myval2._Myfirst } Attributes) }}</DisplayString>

		<Expand>
			<Item Name="Binding">impl()->m_binding</Item>
			<Item Name="Vertex Size">impl()->m_vertexSize</Item>
			<Item Name="Attributes">impl()->m_attributes,view(simple)</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Index Buffer Layout -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12IndexBufferLayout">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DirectX12IndexBufferLayout {{ Index Type = { impl()->m_indexType,en } }}</DisplayString>

		<Expand>
			<Item Name="Index Type">impl()->m_indexType,en</Item>
			<Synthetic Name="Element Size">
				<DisplayString>{ impl()->m_indexType &gt;&gt; 3 } Bytes</DisplayString>
			</Synthetic>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
	
	<!-- Input assembler -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12InputAssembler">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DirectX12InputAssembler {{ Topology = { impl()->m_primitiveTopology,en }, Index Type = { impl()->m_indexBufferLayout._Ptr->m_impl.m_ptr._Ptr->m_indexType,en } ({ impl()->m_vertexBufferLayouts._List._Mypair._Myval2._Mysize } Vertex Buffer Layouts) }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_indexBufferLayout._Ptr == 0">DirectX12InputAssembler {{ Topology = { impl()->m_primitiveTopology,en }, Index Type = None ({ impl()->m_vertexBufferLayouts._List._Mypair._Myval2._Mysize } Vertex Buffer Layouts) }}</DisplayString>

		<Expand>
			<Item Name="Primitive Topology">impl()->m_primitiveTopology,en</Item>
			<Item Name="Index Buffer Layout">impl()->m_indexBufferLayout</Item>
			<Synthetic Name="Vertex Buffer Layouts">
				<DisplayString>{{ Elements = { impl()->m_vertexBufferLayouts._List._Mypair._Myval2._Mysize } }}</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_vertexBufferLayouts._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Buffer -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12Buffer">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DirectX12Buffer {{ Name = { name() }, Type = { impl()->m_type,en }, Total Size = { (impl()->m_alignment == 0 ? impl()->m_elementSize : (impl()->m_elementSize + impl()->m_alignment - 1) &amp; ~(impl()->m_alignment - 1)) * impl()->m_elements } Bytes ({ impl()->m_elements } Elements), Usage = { impl()->m_usage,en } }}</DisplayString>

		<Expand>
			<ExpandedItem>(LiteFX::Rendering::Backends::IDirectX12Buffer*)this,nd</ExpandedItem>
			<Item Name="Name">name()</Item>
			<Item Name="Type">impl()->m_type,en</Item>
			<Item Name="Layout" Condition="impl()->m_type == LiteFX::Rendering::BufferType::Vertex">((LiteFX::Rendering::Backends::DirectX12VertexBuffer*)this)->m_impl.m_ptr._Ptr->m_layout</Item>
			<Item Name="Layout" Condition="impl()->m_type == LiteFX::Rendering::BufferType::Index">((LiteFX::Rendering::Backends::DirectX12IndexBuffer*)this)->m_impl.m_ptr._Ptr->m_layout</Item>
			<Item Name="Usage">impl()->m_usage,en</Item>
			<Item Name="Element Size">impl()->m_elementSize</Item>
			<Item Name="Elements">impl()->m_elements</Item>
			<Item Name="Alignment">impl()->m_alignment</Item>
			<Synthetic Name="Aligned Element Size">
				<DisplayString>{ (impl()->m_alignment == 0 ? impl()->m_elementSize : (impl()->m_elementSize + impl()->m_alignment - 1) &amp; ~(impl()->m_alignment - 1)) }</DisplayString>
			</Synthetic>
			<Synthetic Name="Total Size Size">
				<DisplayString>{ (impl()->m_alignment == 0 ? impl()->m_elementSize : (impl()->m_elementSize + impl()->m_alignment - 1) &amp; ~(impl()->m_alignment - 1)) * impl()->m_elements }</DisplayString>
			</Synthetic>
			<Item Name="Allocator">impl()->m_allocator</Item>
			<Item Name="Allocation">impl()->m_allocation</Item>
			<!--<Item Name="[Resource]">(LiteFX::Resource&lt;Microsoft::WRL::ComPtr&lt;ID3D12Resource&gt;&gt;*)this</Item>-->
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Image -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12Image">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_dimensions == LiteFX::Rendering::ImageDimensions::DIM_1">DirectX12Image {{ Name = { name() }, { impl()->m_extent.m_elements[0] } Px, Format = { impl()->m_format }, Elements = { impl()->m_elements } (Layers: { impl()->m_layers }, Levels: { impl()->m_levels }, Planes: { impl()->m_planes }), Usage = { impl()->m_usage } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_dimensions == LiteFX::Rendering::ImageDimensions::DIM_2">DirectX12Image {{ Name = { name() }, { impl()->m_extent.m_elements[0] }x{ impl()->m_extent.m_elements[1] } Px, Format = { impl()->m_format }, Elements = { impl()->m_elements } (Layers: { impl()->m_layers }, Levels: { impl()->m_levels }, Planes: { impl()->m_planes }), Usage = { impl()->m_usage } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_dimensions == LiteFX::Rendering::ImageDimensions::DIM_3">DirectX12Image {{ Name = { name() }, { impl()->m_extent.m_elements[0] }x{ impl()->m_extent.m_elements[1] }x{ impl()->m_extent.m_elements[2] } Px, Format = { impl()->m_format }, Elements = { impl()->m_elements } (Layers: { impl()->m_layers }, Levels: { impl()->m_levels }, Planes: { impl()->m_planes }), Usage = { impl()->m_usage } }}</DisplayString>

		<Expand>
			<ExpandedItem>(LiteFX::Rendering::Backends::IDirectX12Image*)this,nd</ExpandedItem>
			<Item Name="Name">name()</Item>
			<Item Name="Format">impl()->m_format</Item>
			<Item Name="Samples">impl()->m_samples</Item>
			<Item Name="Dimensions">impl()->m_dimensions</Item>
			<Item Name="Extent">impl()->m_extent,view(simple)</Item>
			<Item Name="Layers">impl()->m_layers</Item>
			<Item Name="Levels">impl()->m_levels</Item>
			<Item Name="Planes">impl()->m_planes</Item>
			<Item Name="Usage">impl()->m_usage</Item>
			<Item Name="Allocator">impl()->m_allocator</Item>
			<Item Name="Allocation">impl()->m_allocation</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Sampler -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12Sampler">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DirectX12Sampler {{ Name = { name() }, Filter = { impl()->m_magFilter,en } | { impl()->m_minFilter,en }, MipMapping = { impl()->m_mipMapMode,en }, Anisotropy = { impl()->m_anisotropy,g } }}</DisplayString>

		<Expand>
			<ExpandedItem>(LiteFX::Rendering::Backends::IDirectX12Sampler*)this,nd</ExpandedItem>
			<Item Name="Name">name()</Item>
			<Item Name="Mag Filter">impl()->m_magFilter</Item>
			<Item Name="Min Filter">impl()->m_minFilter</Item>
			<Item Name="MipMap Mode">impl()->m_mipMapMode</Item>
			<Item Name="MipMap Bias">impl()->m_mipMapBias,g</Item>
			<Item Name="Min LOD">impl()->m_minLod,g</Item>
			<Item Name="Max LOD">impl()->m_maxLod,g</Item>
			<Item Name="Anisotropy">impl()->m_anisotropy,g</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
	
	<!-- BLAS -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12BottomLevelAccelerationStructure">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DirectX12BottomLevelAccelerationStructure {{ Name = { name() }, empty, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_triangleMeshes._Mypair._Myval2._Myfirst != impl()->m_triangleMeshes._Mypair._Myval2._Mylast">DirectX12BottomLevelAccelerationStructure {{ Name = { name() }, { impl()->m_triangleMeshes._Mypair._Myval2._Mylast - impl()->m_triangleMeshes._Mypair._Myval2._Myfirst } Triangle Meshes, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_boundingBoxes._Mypair._Myval2._Myfirst == impl()->m_boundingBoxes._Mypair._Myval2._Mylast">DirectX12BottomLevelAccelerationStructure {{ Name = { name() }, { impl()->m_boundingBoxes._Mypair._Myval2._Mylast - impl()->m_boundingBoxes._Mypair._Myval2._Myfirst } Bounding Boxes, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>

		<Expand>
			<Item Name="Name">name()</Item>
			<Synthetic Name="Triangle Meshes" Condition="impl()->m_triangleMeshes._Mypair._Myval2._Myfirst != impl()->m_triangleMeshes._Mypair._Myval2._Mylast">
				<DisplayString>{ impl()->m_triangleMeshes._Mypair._Myval2._Mylast - impl()->m_triangleMeshes._Mypair._Myval2._Myfirst } Triangle Meshes</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_triangleMeshes,view(simple)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Bounding Boxes" Condition="impl()->m_boundingBoxes._Mypair._Myval2._Myfirst != impl()->m_boundingBoxes._Mypair._Myval2._Mylast">
				<DisplayString>{ impl()->m_boundingBoxes._Mypair._Myval2._Mylast - impl()->m_boundingBoxes._Mypair._Myval2._Myfirst } Bounding Boxes</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_boundingBoxes,view(simple)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Item Name="Flags">impl()->m_flags,en</Item>
			<Synthetic Name="GPU Buffer">
				<DisplayString>{{ Name = { name() }, { impl()->m_size } Bytes at offset { impl()->m_offset,X } }}</DisplayString>

				<Expand>
					<Item Name="Buffer">impl()->m_buffer</Item>
					<Item Name="Offset">impl()->m_offset,X</Item>
					<Item Name="Size">impl()->m_size</Item>
				</Expand>
			</Synthetic>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- TLAS -->
	<Type Name="LiteFX::Rendering::Backends::DirectX12TopLevelAccelerationStructure">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DirectX12TopLevelAccelerationStructure {{ Name = { name() }, empty, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_instances._Mypair._Myval2._Myfirst != impl()->m_instances._Mypair._Myval2._Mylast">DirectX12TopLevelAccelerationStructure {{ Name = { name() }, { impl()->m_instances._Mypair._Myval2._Mylast - impl()->m_instances._Mypair._Myval2._Myfirst } Instances, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>

		<Expand>
			<Item Name="Name">name()</Item>
			<Synthetic Name="Instances">
				<DisplayString>{ impl()->m_instances._Mypair._Myval2._Mylast - impl()->m_instances._Mypair._Myval2._Myfirst } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_instances,view(simple)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Item Name="Flags">impl()->m_flags,en</Item>
			<Synthetic Name="GPU Buffer">
				<DisplayString>{{ Name = { name() }, { impl()->m_size } Bytes at offset { impl()->m_offset,X } }}</DisplayString>

				<Expand>
					<Item Name="Buffer">impl()->m_buffer</Item>
					<Item Name="Offset">impl()->m_offset,X</Item>
					<Item Name="Size">impl()->m_size</Item>
				</Expand>
			</Synthetic>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Barrier -->
	<Type Name="std::tuple&lt;*&gt;" IncludeView="GlobalBarrier">
		<DisplayString>{{ { _Myfirst._Val,en } -> { ((_Mybase *)this)->_Myfirst._Val,en } }}</DisplayString>

		<Expand>
			<Item Name="Access Before">_Myfirst._Val,en</Item>
			<Item Name="Access After">((_Mybase *)this)->_Myfirst._Val,en</Item>
		</Expand>
	</Type>

	<Type Name="std::tuple&lt;*&gt;" IncludeView="BufferBarrier">
		<DisplayString>{{ { _Myfirst._Val,en } -> { ((_Mybase *)this)->_Myfirst._Val,en } }}</DisplayString>

		<Expand>
			<Item Name="Access Before">_Myfirst._Val,en</Item>
			<Item Name="Access After">((_Mybase *)this)->_Myfirst._Val,en</Item>
			<!--<Item Name="Buffer">dynamic_cast&lt;const LiteFX::Rendering::Backends::DirectX12Buffer *&gt;(&amp;((_Mybase::_Mybase *)this)->_Myfirst._Val)</Item>-->
			<Item Name="Buffer">((_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
			<Item Name="Element">((_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
		</Expand>
	</Type>

	<Type Name="std::tuple&lt;*&gt;" IncludeView="ImageBarrier">
		<DisplayString>{{ { _Myfirst._Val,en } -> { ((_Mybase *)this)->_Myfirst._Val,en } }}</DisplayString>

		<Expand>
			<Item Name="Access Before">_Myfirst._Val,en</Item>
			<Item Name="Access After">((_Mybase *)this)->_Myfirst._Val,en</Item>
			<Item Name="Buffer">((_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
			<Item Name="Source Before">((_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
			<Item Name="Target Before">((_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
			<Synthetic Name="Levels" Condition="((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val &gt; 1">
				<DisplayString>{ ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val }-{ ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val + ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val }</DisplayString>
			</Synthetic>
			<Synthetic Name="Level" Condition="((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val == 1">
				<DisplayString>{ ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val }</DisplayString>
			</Synthetic>
			<Synthetic Name="Layers" Condition="((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val &gt; 1">
				<DisplayString>{ ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val }-{ ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val + ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val }</DisplayString>
			</Synthetic>
			<Synthetic Name="Layer" Condition="((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val == 1">
				<DisplayString>{ ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val }</DisplayString>
			</Synthetic>
			<Item Name="Plane">((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
		</Expand>
	</Type>

	<Type Name="LiteFX::Rendering::Backends::DirectX12Barrier">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DirectX12Barrier {{ Sync Before = { impl()->m_syncBefore,en }, Sync After = { impl()->m_syncAfter,en } ({ impl()->m_globalBarriers._Mypair._Myval2._Mylast - impl()->m_globalBarriers._Mypair._Myval2._Myfirst } Global Barriers, { impl()->m_bufferBarriers._Mypair._Myval2._Mylast - impl()->m_bufferBarriers._Mypair._Myval2._Myfirst } Buffer Barriers, { impl()->m_imageBarriers._Mypair._Myval2._Mylast - impl()->m_imageBarriers._Mypair._Myval2._Myfirst } Image Barriers) }}</DisplayString>

		<Expand>
			<Item Name="Sync Before">impl()->m_syncBefore,en</Item>
			<Item Name="Sync After">impl()->m_syncAfter,en</Item>
			<Synthetic Name="Global Barriers">
				<DisplayString>{ impl()->m_globalBarriers._Mypair._Myval2._Mylast - impl()->m_globalBarriers._Mypair._Myval2._Myfirst } Elements</DisplayString>

				<Expand>
					<IndexListItems>
						<Size>impl()->m_globalBarriers._Mypair._Myval2._Mylast - impl()->m_globalBarriers._Mypair._Myval2._Myfirst</Size>
						<ValueNode>impl()->m_globalBarriers._Mypair._Myval2._Myfirst,view(GlobalBarrier)</ValueNode>
					</IndexListItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="Buffer Barriers">
				<DisplayString>{ impl()->m_bufferBarriers._Mypair._Myval2._Mylast - impl()->m_bufferBarriers._Mypair._Myval2._Myfirst } Elements</DisplayString>

				<Expand>
					<IndexListItems>
						<Size>impl()->m_bufferBarriers._Mypair._Myval2._Mylast - impl()->m_bufferBarriers._Mypair._Myval2._Myfirst</Size>
						<ValueNode>impl()->m_bufferBarriers._Mypair._Myval2._Myfirst,view(BufferBarrier)</ValueNode>
					</IndexListItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="Image Barriers">
				<DisplayString>{ impl()->m_imageBarriers._Mypair._Myval2._Mylast - impl()->m_imageBarriers._Mypair._Myval2._Myfirst } Elements</DisplayString>

				<Expand>
					<IndexListItems>
						<Size>impl()->m_imageBarriers._Mypair._Myval2._Mylast - impl()->m_imageBarriers._Mypair._Myval2._Myfirst</Size>
						<ValueNode>impl()->m_imageBarriers._Mypair._Myval2._Myfirst,view(ImageBarrier)</ValueNode>
					</IndexListItems>
				</Expand>
			</Synthetic>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Shader Module -->
