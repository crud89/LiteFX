<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<!-- Graphics Adapter -->
	<Type Name="LiteFX::Rendering::Backends::VulkanGraphicsAdapter">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanGraphicsAdapter {{ Name = { impl()->m_name } (Device ID = { impl()->m_deviceId }, LUID = { impl()->m_luid }) }}</DisplayString>

		<Expand>
			<Item Name="Name">impl()->m_name</Item>
			<Synthetic Name="Memory">
				<DisplayString>{ impl()->m_deviceLocalMemory / 1048576 } Mb</DisplayString>
			</Synthetic>
			<Item Name="Type">impl()->m_type,en</Item>
			<Item Name="Luid">impl()->m_luid,nvoXb</Item>
			<Synthetic Name="Vendor ID">
				<DisplayString Condition="impl()->m_vendorId == 0x1002">AMD (0x{ impl()->m_vendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_vendorId == 0x1010">ImgTec (0x{ impl()->m_vendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_vendorId == 0x10DE">NVidia (0x{ impl()->m_vendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_vendorId == 0x13B5">ARM (0x{ impl()->m_vendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_vendorId == 0x5143">Qualcom (0x{ impl()->m_vendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_vendorId == 0x8086">Intel (0x{ impl()->m_vendorId,nvoXb })</DisplayString>
				<DisplayString Condition="impl()->m_vendorId != 0x1002 &amp;&amp; impl()->m_vendorId != 0x1010 &amp;&amp; impl()->m_vendorId != 0x10DE &amp;&amp; impl()->m_vendorId != 0x13B5 &amp;&amp; impl()->m_vendorId != 0x5143 &amp;&amp; impl()->m_vendorId != 0x8086">Other (0x{ impl()->m_vendorId,nvoXb })</DisplayString>
			</Synthetic>
			<Item Name="Device ID">impl()->m_deviceId</Item>
			<Synthetic Name="Driver Version">
				<!-- NVidia format -->
				<DisplayString Condition="impl()->m_vendorId == 0x10DE">{ (impl()->m_driverVersion &gt;&gt; 22) &amp; 0x3FFF }.{ (impl()->m_driverVersion &gt;&gt; 14) &amp; 0x00FF }.{ (impl()->m_driverVersion &gt;&gt; 6) &amp; 0x00FF }.{ (impl()->m_driverVersion) &amp; 0x003F } (0x{ impl()->m_driverVersion,nvoXb })</DisplayString>
				<!-- Intel format (NOTE: windows only, may print wrong version on other OS) -->
				<DisplayString Condition="impl()->m_vendorId == 0x8086">{ impl()->m_driverVersion &gt;&gt; 14 }.{ impl()->m_driverVersion &amp; 0x3FFFF } (0x{ impl()->m_driverVersion,nvoXb })</DisplayString>
				<!-- Vulkan default format (AMD and others) -->
				<DisplayString Condition="(impl()->m_vendorId != 0x8086) &amp;&amp; (impl()->m_vendorId != 0x1F96)">{ (impl()->m_driverVersion &amp; 0xFF000000) &gt;&gt; 24 }.{ (impl()->m_driverVersion &amp; 0x00FF0000) &gt;&gt; 16 }.{ (impl()->m_driverVersion &amp; 0x0000FF00) &gt;&gt; 8 }.{ (impl()->m_driverVersion &amp; 0x000000FF) } (0x{ impl()->m_driverVersion,nvoXb })</DisplayString>
			</Synthetic>
			<Synthetic Name="API Version">
				<DisplayString>{ (impl()->m_apiVersion &gt;&gt; 22) &amp; 0x007F }.{ (impl()->m_apiVersion &gt;&gt; 12) &amp; 0x03FF }.{ impl()->m_apiVersion &amp; 0x0FFF } (Variant { impl()->m_apiVersion &gt;&gt; 29 }, 0x{ impl()->m_apiVersion,nvoXb })</DisplayString>
			</Synthetic>
			<Item Name="Limits">impl()->m_limits</Item>
			<Item Name="Device Extensions">impl()->m_deviceExtensions,view(simple)</Item>
			<Item Name="Device Layers">impl()->m_deviceLayers,view(simple)</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
	
	<!-- Surface -->
	<Type Name="LiteFX::Rendering::Backends::VulkanSurface">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanSurface {{ hWnd = { impl()->m_hwnd,handle } }}</DisplayString>

		<Expand>
			<Item Name="Window">impl()->m_hwnd,handle</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Vertex Buffer Layout -->
	<Type Name="LiteFX::Rendering::Backends::VulkanVertexBufferLayout">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanVertexBufferLayout {{ Binding = { impl()->m_binding }, Size = { impl()->m_vertexSize } ({ impl()->m_attributes._Mypair._Myval2._Mylast - impl()->m_attributes._Mypair._Myval2._Myfirst } Attributes) }}</DisplayString>

		<Expand>
			<Item Name="Binding">impl()->m_binding</Item>
			<Item Name="Vertex Size">impl()->m_vertexSize</Item>
			<Item Name="Attributes">impl()->m_attributes,view(simple)</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Index Buffer Layout -->
	<!-- 
	     TODO: For some reason this visualizer is unable to resolve some pImpl members in some circumstances due to this bug: https://developercommunity.visualstudio.com/t/Opaque-types-are-not-expandable-by-defau/513715.
               To fix this we will have to provide different natvis files depending on the library type (static/shared).	
	-->
	<!--
	<Type Name="LiteFX::Rendering::Backends::VulkanIndexBufferLayout">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanIndexBufferLayout {{ Binding = { ((LiteFX.Backends.Vulkand.dll!LiteFX::Rendering::Backends::VulkanIndexBufferLayout::VulkanIndexBufferLayoutImpl*)m_impl.m_ptr._Ptr)->m_binding }, Index Type = { ((LiteFX.Backends.Vulkand.dll!LiteFX::Rendering::Backends::VulkanIndexBufferLayout::VulkanIndexBufferLayoutImpl*)m_impl.m_ptr._Ptr)->m_indexType } }}</DisplayString>

		<Expand>
			<Item Name="Binding">((LiteFX.Backends.Vulkand.dll!LiteFX::Rendering::Backends::VulkanIndexBufferLayout::VulkanIndexBufferLayoutImpl*)m_impl.m_ptr._Ptr)->m_binding</Item>
			<Item Name="Buffer Type">((LiteFX.Backends.Vulkand.dll!LiteFX::Rendering::Backends::VulkanIndexBufferLayout::VulkanIndexBufferLayoutImpl*)m_impl.m_ptr._Ptr)->m_bufferType</Item>
			<Item Name="Index Type">((LiteFX.Backends.Vulkand.dll!LiteFX::Rendering::Backends::VulkanIndexBufferLayout::VulkanIndexBufferLayoutImpl*)m_impl.m_ptr._Ptr)->m_indexType</Item>
			<Synthetic Name="Element Size">
				<DisplayString>{ ((LiteFX.Backends.Vulkand.dll!LiteFX::Rendering::Backends::VulkanIndexBufferLayout::VulkanIndexBufferLayoutImpl*)m_impl.m_ptr._Ptr)->m_indexType &gt;&gt; 3 } Bytes</DisplayString>
			</Synthetic>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
	-->
	<Type Name="LiteFX::Rendering::Backends::VulkanIndexBufferLayout">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanIndexBufferLayout {{ Index Type = { impl()->m_indexType,en } }}</DisplayString>

		<Expand>
			<Item Name="Index Type">impl()->m_indexType,en</Item>
			<Synthetic Name="Element Size">
				<DisplayString>{ impl()->m_indexType &gt;&gt; 3 } Bytes</DisplayString>
			</Synthetic>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
	
	<!-- Input assembler -->
	<Type Name="LiteFX::Rendering::Backends::VulkanInputAssembler">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanInputAssembler {{ Topology = { impl()->m_primitiveTopology,en }, Index Type = { impl()->m_indexBufferLayout._Ptr->m_impl.m_ptr._Ptr->m_indexType,en } ({ impl()->m_vertexBufferLayouts._List._Mypair._Myval2._Mysize } Vertex Buffer Layouts) }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_indexBufferLayout._Ptr == 0">VulkanInputAssembler {{ Topology = { impl()->m_primitiveTopology,en }, Index Type = None ({ impl()->m_vertexBufferLayouts._List._Mypair._Myval2._Mysize } Vertex Buffer Layouts) }}</DisplayString>

		<Expand>
			<Item Name="Primitive Topology">impl()->m_primitiveTopology,en</Item>
			<Item Name="Index Buffer Layout">impl()->m_indexBufferLayout</Item>
			<Synthetic Name="Vertex Buffer Layouts">
				<DisplayString>{{ Elements = { impl()->m_vertexBufferLayouts._List._Mypair._Myval2._Mysize } }}</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_vertexBufferLayouts._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Buffer -->
	<Type Name="LiteFX::Rendering::Backends::VulkanBuffer">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanBuffer {{ Name = { name() }, Type = { impl()->m_type,en }, Total Size = { (impl()->m_alignment == 0 ? impl()->m_elementSize : (impl()->m_elementSize + impl()->m_alignment - 1) &amp; ~(impl()->m_alignment - 1)) * impl()->m_elements } Bytes ({ impl()->m_elements } Elements), Usage = { impl()->m_usage,en } }}</DisplayString>

		<Expand>
			<ExpandedItem>(LiteFX::Rendering::Backends::IVulkanBuffer*)this,nd</ExpandedItem>
			<Item Name="Name">name()</Item>
			<Item Name="Type">impl()->m_type,en</Item>
			<Item Name="Layout" Condition="impl()->m_type == LiteFX::Rendering::BufferType::Vertex">((LiteFX::Rendering::Backends::VulkanVertexBuffer*)this)->m_impl.m_ptr._Ptr->m_layout</Item>
			<Item Name="Layout" Condition="impl()->m_type == LiteFX::Rendering::BufferType::Index">((LiteFX::Rendering::Backends::VulkanIndexBuffer*)this)->m_impl.m_ptr._Ptr->m_layout</Item>
			<Item Name="Usage">impl()->m_usage,en</Item>
			<Item Name="Element Size">impl()->m_elementSize</Item>
			<Item Name="Elements">impl()->m_elements</Item>
			<Item Name="Alignment">impl()->m_alignment</Item>
			<Synthetic Name="Aligned Element Size">
				<DisplayString>{ (impl()->m_alignment == 0 ? impl()->m_elementSize : (impl()->m_elementSize + impl()->m_alignment - 1) &amp; ~(impl()->m_alignment - 1)) }</DisplayString>
			</Synthetic>
			<Synthetic Name="Total Size Size">
				<DisplayString>{ (impl()->m_alignment == 0 ? impl()->m_elementSize : (impl()->m_elementSize + impl()->m_alignment - 1) &amp; ~(impl()->m_alignment - 1)) * impl()->m_elements }</DisplayString>
			</Synthetic>
			<Item Name="Allocator">impl()->m_allocator</Item>
			<Item Name="Allocation">impl()->m_allocation</Item>
			<Item Name="[Resource]">(LiteFX::Resource&lt;VkBuffer_T *&gt;*)this</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
	
	<!-- Image -->
	<Type Name="LiteFX::Rendering::Backends::VulkanImage">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_dimensions == LiteFX::Rendering::ImageDimensions::DIM_1">VulkanImage {{ Name = { name() }, { impl()->m_extent.m_elements[0] } Px, Format = { impl()->m_format }, Elements = { impl()->m_elements } (Layers: { impl()->m_layers }, Levels: { impl()->m_levels }, Planes: { impl()->m_planes }), Usage = { impl()->m_usage } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_dimensions == LiteFX::Rendering::ImageDimensions::DIM_2">VulkanImage {{ Name = { name() }, { impl()->m_extent.m_elements[0] }x{ impl()->m_extent.m_elements[1] } Px, Format = { impl()->m_format }, Elements = { impl()->m_elements } (Layers: { impl()->m_layers }, Levels: { impl()->m_levels }, Planes: { impl()->m_planes }), Usage = { impl()->m_usage } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_dimensions == LiteFX::Rendering::ImageDimensions::DIM_3">VulkanImage {{ Name = { name() }, { impl()->m_extent.m_elements[0] }x{ impl()->m_extent.m_elements[1] }x{ impl()->m_extent.m_elements[2] } Px, Format = { impl()->m_format }, Elements = { impl()->m_elements } (Layers: { impl()->m_layers }, Levels: { impl()->m_levels }, Planes: { impl()->m_planes }), Usage = { impl()->m_usage } }}</DisplayString>

		<Expand>
			<ExpandedItem>(LiteFX::Rendering::Backends::IVulkanImage*)this,nd</ExpandedItem>
			<Item Name="Name">name()</Item>
			<Item Name="Format">impl()->m_format</Item>
			<Item Name="Samples">impl()->m_samples</Item>
			<Item Name="Dimensions">impl()->m_dimensions</Item>
			<Item Name="Extent">impl()->m_extent,view(simple)</Item>
			<Item Name="Layers">impl()->m_layers</Item>
			<Item Name="Levels">impl()->m_levels</Item>
			<Item Name="Planes">impl()->m_planes</Item>
			<Item Name="Usage">impl()->m_usage</Item>
			<Item Name="Allocator">impl()->m_allocator</Item>
			<Item Name="Allocation">impl()->m_allocation</Item>
			<Item Name="[Resource]">(LiteFX::Resource&lt;VkImage_T *&gt;*)this</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Sampler -->
	<Type Name="LiteFX::Rendering::Backends::VulkanSampler">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanSampler {{ Name = { name() }, Filter = { impl()->m_magFilter,en } | { impl()->m_minFilter,en }, MipMapping = { impl()->m_mipMapMode,en }, Anisotropy = { impl()->m_anisotropy,g } }}</DisplayString>

		<Expand>
			<ExpandedItem>(LiteFX::Rendering::Backends::IVulkanSampler*)this,nd</ExpandedItem>
			<Item Name="Name">name()</Item>
			<Item Name="Mag Filter">impl()->m_magFilter</Item>
			<Item Name="Min Filter">impl()->m_minFilter</Item>
			<Item Name="MipMap Mode">impl()->m_mipMapMode</Item>
			<Item Name="MipMap Bias">impl()->m_mipMapBias,g</Item>
			<Item Name="Min LOD">impl()->m_minLod,g</Item>
			<Item Name="Max LOD">impl()->m_maxLod,g</Item>
			<Item Name="Anisotropy">impl()->m_anisotropy,g</Item>
			<Item Name="Parent Device">impl()->m_device</Item>
			<Item Name="[Resource]">(LiteFX::Resource&lt;VkSampler_T *&gt;*)this</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
	
	<!-- BLAS -->
	<Type Name="LiteFX::Rendering::Backends::VulkanBottomLevelAccelerationStructure">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanBottomLevelAccelerationStructure {{ Name = { name() }, empty, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_triangleMeshes._Mypair._Myval2._Myfirst != impl()->m_triangleMeshes._Mypair._Myval2._Mylast">VulkanBottomLevelAccelerationStructure {{ Name = { name() }, { impl()->m_triangleMeshes._Mypair._Myval2._Mylast - impl()->m_triangleMeshes._Mypair._Myval2._Myfirst } Triangle Meshes, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_boundingBoxes._Mypair._Myval2._Myfirst == impl()->m_boundingBoxes._Mypair._Myval2._Mylast">VulkanBottomLevelAccelerationStructure {{ Name = { name() }, { impl()->m_boundingBoxes._Mypair._Myval2._Mylast - impl()->m_boundingBoxes._Mypair._Myval2._Myfirst } Bounding Boxes, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>

		<Expand>
			<Item Name="Name">name()</Item>
			<Synthetic Name="Triangle Meshes" Condition="impl()->m_triangleMeshes._Mypair._Myval2._Myfirst != impl()->m_triangleMeshes._Mypair._Myval2._Mylast">
				<DisplayString>{ impl()->m_triangleMeshes._Mypair._Myval2._Mylast - impl()->m_triangleMeshes._Mypair._Myval2._Myfirst } Triangle Meshes</DisplayString>
				
				<Expand>
					<ExpandedItem>impl()->m_triangleMeshes,view(simple)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Bounding Boxes" Condition="impl()->m_boundingBoxes._Mypair._Myval2._Myfirst != impl()->m_boundingBoxes._Mypair._Myval2._Mylast">
				<DisplayString>{ impl()->m_boundingBoxes._Mypair._Myval2._Mylast - impl()->m_boundingBoxes._Mypair._Myval2._Myfirst } Bounding Boxes</DisplayString>
				
				<Expand>
					<ExpandedItem>impl()->m_boundingBoxes,view(simple)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Item Name="Flags">impl()->m_flags,en</Item>
			<Synthetic Name="GPU Buffer">
				<DisplayString>{{ Name = { name() }, { impl()->m_size } Bytes at offset { impl()->m_offset,X } }}</DisplayString>

				<Expand>
					<Item Name="Buffer">impl()->m_buffer</Item>
					<Item Name="Offset">impl()->m_offset,X</Item>
					<Item Name="Size">impl()->m_size</Item>
				</Expand>
			</Synthetic>
			<Item Name="Query Pool">impl()->m_queryPool</Item>
			<Item Name="Parent Device">impl()->m_device</Item>
			<Item Name="[Resource]">(LiteFX::Resource&lt;VkAccelerationStructureKHR_T *&gt;*)this</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- TLAS -->
	<Type Name="LiteFX::Rendering::Backends::VulkanTopLevelAccelerationStructure">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<Intrinsic Name="name" Expression="((LiteFX::Rendering::StateResource*)this)->m_impl.m_ptr._Ptr->m_name" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">VulkanTopLevelAccelerationStructure {{ Name = { name() }, empty, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>
		<DisplayString Condition="impl() != 0 &amp;&amp; impl()->m_instances._Mypair._Myval2._Myfirst != impl()->m_instances._Mypair._Myval2._Mylast">VulkanTopLevelAccelerationStructure {{ Name = { name() }, { impl()->m_instances._Mypair._Myval2._Mylast - impl()->m_instances._Mypair._Myval2._Myfirst } Instances, Size = { impl()->m_size }, Flags = { impl()->m_flags,en } }}</DisplayString>

		<Expand>
			<Item Name="Name">name()</Item>
			<Synthetic Name="Instances">
				<DisplayString>{ impl()->m_instances._Mypair._Myval2._Mylast - impl()->m_instances._Mypair._Myval2._Myfirst } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_instances,view(simple)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Item Name="Flags">impl()->m_flags,en</Item>
			<Synthetic Name="GPU Buffer">
				<DisplayString>{{ Name = { name() }, { impl()->m_size } Bytes at offset { impl()->m_offset,X } }}</DisplayString>

				<Expand>
					<Item Name="Buffer">impl()->m_buffer</Item>
					<Item Name="Offset">impl()->m_offset,X</Item>
					<Item Name="Size">impl()->m_size</Item>
				</Expand>
			</Synthetic>
			<Item Name="Query Pool">impl()->m_queryPool</Item>
			<Item Name="Parent Device">impl()->m_device</Item>
			<Item Name="[Resource]">(LiteFX::Resource&lt;VkAccelerationStructureKHR_T *&gt;*)this</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
	
	<!-- Barrier -->
	<Type Name="std::tuple&lt;*&gt;" IncludeView="GlobalBarrier">
		<DisplayString>{{ { _Myfirst._Val,en } -> { ((_Mybase *)this)->_Myfirst._Val,en } }}</DisplayString>

		<Expand>
			<Item Name="Access Before">_Myfirst._Val,en</Item>
			<Item Name="Access After">((_Mybase *)this)->_Myfirst._Val,en</Item>
		</Expand>
	</Type>

	<Type Name="std::tuple&lt;*&gt;" IncludeView="BufferBarrier">
		<DisplayString>{{ { _Myfirst._Val,en } -> { ((_Mybase *)this)->_Myfirst._Val,en } }}</DisplayString>
		
		<Expand>
			<Item Name="Access Before">_Myfirst._Val,en</Item>
			<Item Name="Access After">((_Mybase *)this)->_Myfirst._Val,en</Item>
			<!--<Item Name="Buffer">dynamic_cast&lt;const LiteFX::Rendering::Backends::VulkanBuffer *&gt;(&amp;((_Mybase::_Mybase *)this)->_Myfirst._Val)</Item>-->
			<Item Name="Buffer">((_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
			<Item Name="Element">((_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
		</Expand>
	</Type>

	<Type Name="std::tuple&lt;*&gt;" IncludeView="ImageBarrier">
		<DisplayString>{{ { _Myfirst._Val,en } -> { ((_Mybase *)this)->_Myfirst._Val,en } }}</DisplayString>

		<Expand>
			<Item Name="Access Before">_Myfirst._Val,en</Item>
			<Item Name="Access After">((_Mybase *)this)->_Myfirst._Val,en</Item>
			<Item Name="Buffer">((_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
			<Item Name="Source Before">((_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
			<Item Name="Target Before">((_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val</Item>
			<Synthetic Name="Levels" Condition="((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val &gt; 1">
				<DisplayString>{ ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val }-{ ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val + ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val }</DisplayString>
			</Synthetic>
			<Synthetic Name="Level" Condition="((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val == 1">
				<DisplayString>{ ((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val }</DisplayString>
			</Synthetic>
			<Synthetic Name="Layers" Condition="((_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase::_Mybase *)this)->_Myfirst._Val &gt; 1">
