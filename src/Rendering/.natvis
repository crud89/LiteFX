<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<!-- Buffer attribute -->
	<Type Name="LiteFX::Rendering::BufferAttribute">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString>BufferAttribute {{ Location = { impl()->m_location }, Offset = { impl()->m_offset }, Format = { impl()->m_format,en } }}</DisplayString>

		<Expand>
			<Item Name="Location">impl()->m_location</Item>
			<Item Name="Offset">impl()->m_offset</Item>
			<Item Name="Format">impl()->m_format,en</Item>
			<Item Name="Semantic">impl()->m_semantic,en</Item>
			<Item Name="Semantic Index">impl()->m_semanticIndex</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Rasterizer -->
	<Type Name="LiteFX::Rendering::Rasterizer" Inheritable="true">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">Rasterizer {{ Polygon Mode = { impl()->m_polygonMode,en }, Cull Mode = { impl()->m_cullMode,en }, Cull Order = { impl()->m_cullOrder,en } }}</DisplayString>

		<Expand>
			<Item Name="Polygon Mode">impl()->m_polygonMode,en</Item>
			<Item Name="Cull Mode">impl()->m_cullMode,en</Item>
			<Item Name="Cull Order">impl()->m_cullOrder,en</Item>
			<Item Name="Depth/Stencil State">impl()->m_depthStencilState</Item>
			<Item Name="Line Width">impl()->m_lineWidth</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Depth/Stencil State -->
	<Type Name="LiteFX::Rendering::DepthStencilState" Inheritable="true">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DepthStencilState {{ Depth Test = { impl()->m_depthState.Enable }, Stencil Test = { impl()->m_stencilState.Enable }, Depth Bias = { impl()->m_depthBias.Enable } }}</DisplayString>

		<Expand>
			<Item Name="Depth State">impl()->m_depthState</Item>
			<Item Name="Depth Bias">impl()->m_depthBias</Item>
			<Item Name="Stencil State">impl()->m_stencilState</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Shader Record Collection -->
	<Type Name="LiteFX::Rendering::ShaderRecordCollection">
		<DisplayString>ShaderRecordCollection {{ { m_records._Mypair._Myval2._Mylast - m_records._Mypair._Myval2._Myfirst } Records }}</DisplayString>

		<Expand>
			<Item Name="Shader Program">m_program</Item>
			<Item Name="Records">m_records,view(simple)</Item>
		</Expand>
	</Type>

	<!-- Shader Record -->
	<Type Name="LiteFX::Rendering::ShaderRecord&lt;&gt;">
		<DisplayString>ShaderRecord&lt;&gt; {{ Local Data Size = 0 Bytes }}</DisplayString>

		<Expand>
			<Item Name="Shader Group">m_shaderGroup,view(simple)</Item>
		</Expand>
	</Type>
	
	<Type Name="LiteFX::Rendering::ShaderRecord&lt;*&gt;">
		<DisplayString>ShaderRecord&lt;{ "$T1",sb }&gt; {{ Local Data Size = { sizeof($T1) } Bytes }}</DisplayString>

		<Expand>
			<Item Name="Shader Group">m_shaderGroup,view(simple)</Item>
			<Item Name="Local Data">m_payload</Item>
			<Synthetic Name="Local Data Size">
				<DisplayString>{ sizeof($T1) }</DisplayString>
			</Synthetic>
		</Expand>
	</Type>

	<!-- Render Target -->
	<Type Name="LiteFX::Rendering::RenderTarget">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">RenderTarget {{ Name = { impl()->m_name }, Type = { impl()->m_type,en }, Format = { impl()->m_format,en }, Location = { impl()->m_location } }}</DisplayString>

		<Expand>
			<Item Name="Name">impl()->m_name</Item>
			<Item Name="Type">impl()->m_type,en</Item>
			<Item Name="Format">impl()->m_format,en</Item>
			<Item Name="Location">impl()->m_location</Item>
			<Item Name="Flags">impl()->m_flags,en</Item>
			<Item Name="Blend State">impl()->m_blendState</Item>
			<Item Name="Clear Values">impl()->m_clearValues</Item>
			<Item Name="Identifier">impl()->m_identifier</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Descriptor Binding Point -->
	<Type Name="LiteFX::Rendering::DescriptorBindingPoint">
		<DisplayString ExcludeView="simple">DescriptorBindingPoint {{ Register = { Register }, Space = { Space } }}</DisplayString>
		<DisplayString IncludeView="simple">{{ Register = { Register }, Space = { Space } }}</DisplayString>

		<Expand>
			<Item Name="Register">Register</Item>
			<Item Name="Space">Space</Item>
		</Expand>
	</Type>
	
	<!-- Render Pass Dependency -->
	<Type Name="LiteFX::Rendering::RenderPassDependency">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">RenderPassDependency {{ Render Target = { impl()->m_renderTarget.m_impl.m_ptr._Ptr->m_name }, Binding = { impl()->m_descriptorBinding,view(simple) } }}</DisplayString>

		<Expand>
			<Item Name="Render Target">impl()->m_renderTarget</Item>
			<Item Name="Binding Point">impl()->m_descriptorBinding</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
	
	<!-- Device State -->
	<Type Name="LiteFX::Rendering::DeviceState">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0"> DeviceState {{ { impl()->m_renderPasses._List._Mypair._Myval2._Mysize + impl()->m_frameBuffers._List._Mypair._Myval2._Mysize + impl()->m_pipelines._List._Mypair._Myval2._Mysize + impl()->m_buffers._List._Mypair._Myval2._Mysize + impl()->m_vertexBuffers._List._Mypair._Myval2._Mysize + impl()->m_indexBuffers._List._Mypair._Myval2._Mysize + impl()->m_images._List._Mypair._Myval2._Mysize + impl()->m_samplers._List._Mypair._Myval2._Mysize + impl()->m_accelerationStructures._List._Mypair._Myval2._Mysize + impl()->m_descriptorSets._List._Mypair._Myval2._Mysize } Instances }}</DisplayString>

		<Expand>
			<Synthetic Name="Buffers">
				<DisplayString>{ impl()->m_buffers._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_buffers._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Vertex Buffers">
				<DisplayString>{ impl()->m_vertexBuffers._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_vertexBuffers._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Index Buffers">
				<DisplayString>{ impl()->m_indexBuffers._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_indexBuffers._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Images">
				<DisplayString>{ impl()->m_images._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_images._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Samplers">
				<DisplayString>{ impl()->m_samplers._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_samplers._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Acceleration Structures">
				<DisplayString>{ impl()->m_accelerationStructures._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_accelerationStructures._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Descriptor Sets">
				<DisplayString>{ impl()->m_descriptorSets._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_descriptorSets._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Pipelines">
				<DisplayString>{ impl()->m_pipelines._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_pipelines._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Render Passes">
				<DisplayString>{ impl()->m_renderPasses._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_renderPasses._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Synthetic Name="Frame Buffers">
				<DisplayString>{ impl()->m_frameBuffers._List._Mypair._Myval2._Mysize } Instances</DisplayString>

				<Expand>
					<ExpandedItem>impl()->m_frameBuffers._List,view(DictionaryHelper)</ExpandedItem>
				</Expand>
			</Synthetic>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>

	<!-- Descriptor Allocation Range -->
	<Type Name="LiteFX::Rendering::DescriptorAllocationRange">
		<DisplayString Condition="Unbounded">{{ Binding = { Binding }, Heap = { Heap,en }, Offset = { RelativeOffset }, Unbounded }}</DisplayString>
		<DisplayString>{{ Binding = { Binding }, Heap = { Heap,en }, Offset = { RelativeOffset }, Descriptors = { DescriptorCount } }}</DisplayString>
	</Type>

	<!-- Descriptor Allocation Layout -->
	<Type Name="LiteFX::Rendering::DescriptorAllocationLayout">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">DescriptorAllocationLayout {{ Ranges = { impl()->m_ranges._Mypair._Myval2._Mylast - impl()->m_ranges._Mypair._Myval2._Myfirst } }}</DisplayString>

		<Expand>
			<ExpandedItem>impl()->m_ranges,view(simple)</ExpandedItem>
		</Expand>
	</Type>

	<!-- Descriptor Heap Allocation -->
	<Type Name="LiteFX::Rendering::DescriptorHeapAllocation">
		<DisplayString Condition="Allocation.Offset == 0xFFFFFFFFFFFFFFFF">{{ Empty }}</DisplayString>
		<DisplayString>{{ Heap = { Heap,en }, Offset = { Allocation.Offset }, Descriptors = { Allocation.Size } }}</DisplayString>

		<Expand>
			<Item Name="Heap">Heap,en</Item>
			<Item Name="Offset">Allocation.Offset</Item>
			<Item Name="Descriptors">Allocation.Size</Item>
			<Item Name="Handle">Allocation.Handle,X</Item>
		</Expand>
	</Type>

	<!-- Tracked Command Buffer Resources -->
	<Type Name="LiteFX::Rendering::ICommandBuffer::TrackedResources">
		<DisplayString>{{ { Resources._Mypair._Myval2._Mylast - Resources._Mypair._Myval2._Myfirst } Resources, { DescriptorSets._Mypair._Myval2._Mylast - DescriptorSets._Mypair._Myval2._Myfirst } Descriptor Sets, { DescriptorRanges._Mypair._Myval2._Mylast - DescriptorRanges._Mypair._Myval2._Myfirst } Descriptor Ranges, { SecondaryCommandBuffers._Mypair._Myval2._Mylast - SecondaryCommandBuffers._Mypair._Myval2._Myfirst } Secondary Command Buffers }}</DisplayString>

		<Expand>
			<Item Name="Resources">Resources,view(simple)</Item>
			<Item Name="Descriptor Sets">DescriptorSets,view(simple)</Item>
			<Item Name="Descriptor Ranges">DescriptorRanges,view(simple)</Item>
			<Item Name="Secondary Command Buffers">SecondaryCommandBuffers,view(simple)</Item>
		</Expand>
	</Type>

	<!-- Global Descriptor Heaps -->
	<Type Name="LiteFX::Rendering::GlobalDescriptorHeaps">
		<Intrinsic Name="impl" Expression="m_impl.m_ptr._Ptr" />
		<DisplayString Condition="impl() == 0">uninitialized</DisplayString>
		<DisplayString Condition="impl() != 0">GlobalDescriptorHeaps</DisplayString>

		<Expand>
			<Item Name="Resource Heap Allocator">impl()->m_resources.Allocator</Item>
			<Item Name="Sampler Heap Allocator">impl()->m_samplers.Allocator</Item>
			<Item Name="[m_impl]">m_impl</Item>
		</Expand>
	</Type>
</AutoVisualizer>